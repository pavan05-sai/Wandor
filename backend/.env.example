# Environment Configuration
ENVIRONMENT=development
DEMO_MODE=auto

# Database (MongoDB primary - e.g. MongoDB Atlas: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=wandor

# Security & Authentication (minimum 32-character secrets in production)
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
JWT_SECRET=your-jwt-secret-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (Google Gemini API)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.0-flash

# CORS (comma-separated allowed origins; *.vercel.app is automatically supported)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
LLM_RATE_LIMIT_PER_MINUTE=10

# External APIs
OSRM_URL=http://router.project-osrm.org
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
NOMINATIM_URL=https://nominatim.openstreetmap.org
